<p style="color: green"><%= notice %></p>

<% if @review.present? %>
  <%= render partial: "reviews/review_detail", locals: { review: @review } %>
  <div>
    <%= link_to "Edit this review", edit_review_path(@review) %> |
    <%= link_to "Back", reviews_path %>
  </div>
<% else %>
  <p class="muted">レビューが見つかりません。</p>
<% end %>