<style>
    /* review grid card */
.grid-reviews {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 18px;
  margin-top: 18px;
}

.review-card {
  display: flex;
  flex-direction: column;
  background: #fff;
  border-radius: 10px;
  box-shadow: 0 6px 18px rgba(0,0,0,0.04);
  overflow: hidden;
}

.review-card .thumb {
  width: 100%;
  height: 0;
  padding-top: 56%; /* 16:9-ish ratio */
  position: relative;
  overflow: hidden;
}

.review-thumb-img {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.card-body {
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.card-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 8px;
}

.card-title { margin: 0; font-size: 16px; font-weight: 700; color: #0f172a; }

.card-meta { font-size: 13px; color: #6b7280; margin: 0; }

.card-excerpt { color: #374151; font-size: 14px; margin-top: 6px; }

.card-actions { margin-top: auto; text-align: right; }

.btn.small { padding: 6px 10px; background: #2563eb; color: #fff; border-radius: 6px; text-decoration:none; }

</style>
<%# app/views/reviews/_review_grid_card.html.erb %>
<%# locals: review %>

<article class="review-card">
  <div class="thumb">
    <%= link_to review_path(review) do %>
      <% if review.respond_to?(:jacket) && review.jacket.attached? %>
        <%= image_tag review.jacket.variant(resize_to_limit: [260,260]), alt: review.title, class: "review-thumb-img" %>
      <% else %>
        <%= image_tag "placeholder-side.jpg", alt: review.title, class: "review-thumb-img" %>
      <% end %>
    <% end %>
  </div>

  <div class="card-body">
    <div class="card-top">
      <h4 class="card-title"><%= link_to truncate(review.title, length: 36), review_path(review) %></h4>
      <div class="card-rating">
        <%= render partial: "shared/stars", locals: { rating: review.try(:rating) } %>
      </div>
    </div>

    <p class="card-meta"><%= review.try(:genre) %> / <%= review.try(:platform) %></p>

    <div class="card-excerpt">
      <%= simple_format(truncate(review.body.to_s, length: 120)) %>
    </div>

    <div class="card-actions">
      <%= link_to "詳細", review_path(review), class: "btn small" %>
    </div>
  </div>
</article>