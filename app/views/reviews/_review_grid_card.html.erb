<style>
/* ここだけ変更してください：グリッドカード内に限定 */
.review-card .thumb { 
  width: 100%;
  height: 0;
  padding-top: 56%;
  position: relative;
  overflow: hidden;
}

.review-card .thumb .review-thumb-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

  .card-meta {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .avg-row {
    margin-top: auto;              /* ← 下に押し込む */
    padding-top: 10px;
    border-top: 1px solid #f1f5f9;
    display: flex;
    flex-wrap: wrap;               /* 画面狭い時に折り返し */
    gap: 10px 14px;
    font-size: 12px;
    color: #6b7280;
    line-height: 1.2;
  }

  .avg-item {
    display: inline-flex;
    gap: 6px;
    align-items: baseline;
    white-space: nowrap;           /* 途中で変に改行しない */
  }

  .avg-num {
    font-weight: 700;
    color: #0f172a;
  }
</style>

<%# app/views/reviews/_review_grid_card.html.erb %>
<article class="review-card" id="review-card-<%= review.id %>">
  <div class="thumb">
    <% if review.jacket.attached? %>
      <% src = url_for(review.jacket) + "?t=#{review.updated_at.to_i}" %>
      <%= link_to review_path(review) do %>
        <%= image_tag src, alt: review.title, id: "review-jacket-#{review.id}", class: "review-thumb-img" %>
      <% end %>
    <% else %>
      <div class="thumb-placeholder muted">No Image</div>
    <% end %>
  </div>

  <div class="card-body">
    <h4 class="card-title"><%= link_to truncate(review.title, length: 36), review_path(review) %></h4>
    <div class="card-rating">
      <%= render partial: "shared/stars", locals: { rating: review.try(:rating) } %>
    </div>
    <p class="card-meta"><%= review.try(:genre) %> / <%= review.try(:platform) %></p>
    <div class="card-excerpt"><%= simple_format(truncate(review.body.to_s, length: 120)) %></div>
    <div class="avg-row">
      <span class="avg-item">参考 <span class="avg-num"><%= review.respond_to?(:avg_helpfulness) && review.avg_helpfulness ? sprintf("%.1f", review.avg_helpfulness.to_f) : "-" %></span></span>
      <span class="avg-item">遊びたい <span class="avg-num"><%= review.respond_to?(:avg_want_to_play) && review.avg_want_to_play ? sprintf("%.1f", review.avg_want_to_play.to_f) : "-" %></span></span>
      <span class="avg-item">すすめたい <span class="avg-num"><%= review.respond_to?(:avg_recommend_to_friend) && review.avg_recommend_to_friend ? sprintf("%.1f", review.avg_recommend_to_friend.to_f) : "-" %></span></span>
    </div>
  </div>
</article>