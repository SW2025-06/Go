<div id="<%= dom_id(review) %>" class="review">
  <% if review.jacket.attached? %>
    <div class="thumb">
      <%= link_to review_path(review) do %>
        <%= image_tag review.jacket.variant(resize_to_limit: [380, 380]), alt: review.title %>
      <% end %>
    </div>
  <% end %>

  <h3><%= link_to review.title, review %></h3>
  <p><%= review.genre %> / <%= review.platform %></p>
  <p><%= simple_format(truncate(review.body, length: 240)) %></p>
</div>