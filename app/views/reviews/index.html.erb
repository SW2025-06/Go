<style>
/* ---- 全体レイアウト ---- */
.reviews-layout {
  display: grid;
  grid-template-columns: 300px 1fr; /* 左幅固定、右が伸びる */
  gap: 24px;
  align-items: start;
}

/* モバイルでは縦並び（サイド→コンテンツ） */
@media (max-width: 880px) {
  .reviews-layout { grid-template-columns: 1fr; gap: 12px; }
}

/* ---- サイドバー（左） ---- */
.sidebar {
  position: relative;
  top: 0;
  align-self: start;
}

/* 検索ボックス */
.search-box { margin-bottom: 20px; }
.search-input {
  width: 100%;
  padding: 10px 12px;
  border-radius: 8px;
  border: 1px solid #e6edf3;
  box-sizing: border-box;
}

/* ドロップダウン群（縦並び） */
.filters {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-bottom: 18px;
}

.filter-card {
  background: #fff;
  border-radius: 10px;
  padding: 12px;
  box-shadow: 0 4px 16px rgba(16,24,40,0.04);
}

.filter-card h4 { margin: 0 0 8px 0; font-size: 14px; }
.genre-links, .platform-links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; }
.genre-links li a, .platform-links li a {
  text-decoration: none;
  color: #111827;
  padding: 6px 8px;
  border-radius: 6px;
}
.genre-links li a:hover, .platform-links li a:hover { background: #f1f5f9; }

/* サイドのハイライトサムネ */
.side-thumbs { margin-top: 12px; display: grid; gap: 10px; }
.side-thumb img { width: 100%; height: 100%; object-fit: cover; border-radius: 8px; display:block; }

/* ---- メインコンテンツ（右） ---- */
.content {
  min-width: 0; /* flex/grid のあふれ防止 */
}

/* リストヘッダ */
.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}

/* large-review（最上段） */
.large-review {
  display: grid;
  grid-template-columns: 360px 1fr;
  gap: 18px;
  margin-bottom: 20px;
  align-items: start;
}
.large-thumb {
  width: 360px;
  height: 360px;
  overflow: hidden;
  border-radius: 12px;
  background: #f7fafc;
  border: 1px solid #e6edf3;
}
.large-thumb img { width: 100%; height: 100%; object-fit: cover; display:block; }

/* excerpt 等 */
.large-meta .title { margin: 0 0 8px 0; font-size: 20px; }
.excerpt-box { color: #374151; }

/* グリッド */
.grid-reviews {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: 18px;
}

/* 調整：フォームやボタンの余白 */
.sort-box { display: flex; align-items:center; gap: 8px; }

/* ユーティリティ */
.muted { color:#6b7280; font-size: 13px; }
.btn { text-decoration:none; padding:8px 12px; border-radius:8px; display:inline-block; }
</style>

<main class="reviews-layout">
  <!-- 左：検索／フィルタ -->
  <aside class="sidebar">
    <div class="search-box filter-card">
      <%= form_with url: reviews_path, method: :get, local: true do |f| %>
        <%= f.text_field :q, value: params[:q], placeholder: "レビューを検索", class: "search-input" %>
      <% end %>
    </div>

    <div class="filters">
      <div class="filter-card">
        <h4>プラットフォーム</h4>
        <ul class="platform-links">
          <% ["PC","スマホ","Switch","PS4/PS5","Xbox"].each do |p| %>
            <li><%= link_to p, reviews_path(platform: p), class: "" %></li>
          <% end %>
        </ul>
      </div>

      <div class="filter-card">
        <h4>ジャンル</h4>
        <ul class="genre-links">
          <% ["アクション","RPG","シミュレーション","シューティング","音楽ゲーム","レースゲーム","ホラーゲーム","ストラテジ","パズル","格闘ゲーム"].each do |g| %>
            <li><%= link_to g, reviews_path(genre: g) %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </aside>

  <!-- 右：レビュー一覧 -->
  <section class="content">
    <div class="list-header">
      <h2>投稿されたレビュー</h2>
      <div class="sort-box">
        <%= form_with url: reviews_path, method: :get, local: true do |f| %>
          <%= hidden_field_tag :q, params[:q] if params[:q].present? %>
          <label class="muted">ソート</label>
          <%= select_tag :sort, options_for_select([["新着順", "new"],
      ["参考になった 平均", "helpfulness"],
      ["遊びたい 平均", "want_to_play"],
      ["友達にすすめたい 平均", "recommend"]
      ], params[:sort]), include_blank: false, onchange: 'this.form.submit()' %>
        <% end %>
      </div>
    </div>

    <% if @reviews.present? %>
      <% first_review = @reviews.first %>
      <article class="large-review">
        <div class="large-thumb">
          <%= link_to review_path(first_review) do %>
            <% if first_review.jacket.attached? %>
              <%= image_tag url_for(first_review.jacket), alt: first_review.title %>
            <% else %>
              <div class="thumb-placeholder muted">No Image</div>
            <% end %>
          <% end %>
        </div>

        <div class="large-meta">
          <div class="stars">
            <%= render partial: "shared/stars", locals: { rating: first_review.try(:rating) } %>
          </div>
          <h3 class="title"><%= link_to first_review.title, first_review %></h3>
          <p class="meta-line muted"><%= first_review.try(:genre) %>　/　<%= first_review.try(:platform) %></p>
          <div class="excerpt-box"><%= simple_format(truncate(first_review.body, length: 240)) %></div>
          <div class="meta-actions" style="margin-top:12px;">
            <%= link_to "詳細を見る", review_path(first_review), class: "btn" %>
          </div>
        </div>
      </article>
    <% end %>

    <div class="grid-reviews" style="margin-top:18px;">
      <% @reviews.offset(1).each do |review| %>
        <%= render partial: "review_grid_card", locals: { review: review } %>
      <% end %>
    </div>
  </section>
</main>