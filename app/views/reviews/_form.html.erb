<%= turbo_frame_tag "new_review" do %>
  <%= form_with(model: review, local: true) do |f| %>
    <% if review.errors.any? %>
      <div class="errors">
        <ul>
          <% review.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>
    
    

<style>
/* ===== レビューフォーム共通CSS（index / new 両対応） ===== */

.card.form-card {
  background: #fff;
  border-radius: 14px;
  padding: 18px;
  box-shadow: 0 10px 30px rgba(16,24,40,0.06);
}

.form-grid {
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: 18px;
  align-items: start;
}

.rating-block {
  display: flex;
  flex-direction: column;
  gap: 8px;
  align-items: flex-start;
}

.form-row {
  margin-bottom: 12px;
}

.form-label {
  display: block;
  margin-bottom: 6px;
  font-weight: 700;
  color: #0f172a;
}

.form-control,
.form-control-file,
textarea {
  width: 100%;
  padding: 10px;
  border-radius: 8px;
  border: 1px solid #e6edf3;
  box-sizing: border-box;
}

.form-actions {
  margin-top: 14px;
  display: flex;
  gap: 12px;
  justify-content: flex-end;
}

.star-rating {
  display: flex;
  flex-direction: column;   /* ← 横 → 縦 */
  gap: 8px;
  align-items: flex-start;  /* 左揃え */
}

.star-label {
  display: flex;
  align-items: center;
  cursor: pointer;}

.star-img { width:200px !important; height:auto !important; display:block !important; object-fit:contain !important; }

.star-label input {display: none;}

.star-label input:checked + img {
  outline: 2px solid #2563eb;
  border-radius: 6px;
  background: rgba(37,99,235,0.1);
}

/* スマホ */
@media (max-width: 860px) {
  .form-grid { grid-template-columns: 1fr; }
}
</style>
    
    
    <div class="card form-card">
      <div class="form-grid">
        <!-- 左：評価ブロック -->
        <div class="rating-block">
          <label class="form-label">評価</label>
          <div class="star-rating" role="radiogroup" aria-label="評価">
            <% (1..5).each do |i| %>
              <label class="star-label" data-value="<%= i %>">
                <input type="radio" name="review[rating]" value="<%= i %>" <%= "checked" if review.rating.to_i == i %> />
                <%= image_tag "stars/star#{i}.png", alt: "#{i} 星", class: "star-img" %>
              </label>
            <% end %>
          </div>
          <p class="muted small">クリックして評価を選んでください</p>
        </div>
        
        <rb>

        <!-- 右：基本入力 -->
        <div>
          <div class="form-row">
            <%= f.label :title, "タイトル", class: "form-label" %>
            <%= f.text_field :title, class: "form-control", placeholder: "レビューのタイトルを入力" %>
          </div>

          <div class="form-row two-cols">
            <div style="flex:1; margin-right:8px;">
              <%= f.label :genre, "ジャンル", class: "form-label" %>
              <%= f.select :genre, options_for_select(["アクション","RPG","シミュレーション","シューティング","音楽ゲーム","レースゲーム","ホラーゲーム","ストラテジ","パズル","格闘ゲーム"], review.genre), { include_blank: "選択してください" }, class: "form-control" %>
            </div>
            <div style="flex:1; margin-left:8px;">
              <%= f.label :platform, "プラットフォーム", class: "form-label" %>
              <%= f.select :platform, options_for_select(["PC","スマホ","Switch","PS4/PS5","Xbox"], review.platform), { include_blank: "選択してください" }, class: "form-control" %>
            </div>
          </div>

          <div class="form-row">
            <%= f.label :jacket, "ジャケット画像", class: "form-label" %>
            <%= f.file_field :jacket, accept: "image/png,image/jpeg,image/webp", class: "form-control-file" %>
            <% if review.jacket.attached? %>
              <div class="preview">
                <%= image_tag review.jacket.variant(resize_to_limit: [220,220]) %>
              </div>
            <% end %>
          </div>

          <!-- ここに購入先URLを追加 -->
          <div class="form-row">
            <%= f.label :purchase_url, "購入先リンク（任意）", class: "form-label" %>
            <%= f.url_field :purchase_url, class: "form-control", placeholder: "例: https://store.example.com/product/123" %>
            <p class="muted small">ショップの URL を入力してください（コピー＆ペースト可）</p>
          </div>
        </div>

        <!-- 感想はフル幅 -->
        <div class="full">
          <div class="form-row">
            <%= f.label :body, "感想／説明", class: "form-label" %>
            <%= f.text_area :body, rows: 6, class: "form-control", placeholder: "このゲームの良かった点・気になった点など" %>
          </div>
        </div>
      </div>

      <div class="form-actions">
        <%= f.submit review.persisted? ? "更新" : "投稿", class: "btn primary large" %>
        <%= link_to "キャンセル", reviews_path, class: "btn link" %>
      </div>
    </div>
  <% end %>
<% end %>