<%= turbo_frame_tag "new_review" do %>
  <%= form_with(model: review, local: true) do |f| %>
    <% if review.errors.any? %>
      <div class="errors">
        <ul>
          <% review.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="card form-card">
      <div class="form-row rating-row">
        <label class="form-label">評価</label>
        <div class="star-rating" role="radiogroup" aria-label="評価">
          <% 5.downto(1) do |i| %>
            <% id = "star_#{i}" %>
            <input type="radio" name="review[rating]" id="<%= id %>" value="<%= i %>" <%= "checked" if review.rating.to_i == i %> />
            <label for="<%= id %>" class="star-label" data-value="<%= i %>">
              <%= image_tag "stars/star#{i}.png", alt: "#{i} 星", class: "star-img" %>
            </label>
          <% end %>
        </div>
      </div>

      <div class="form-row">
        <%= f.label :title, "Title", class: "form-label" %>
        <%= f.text_field :title, class: "form-control" %>
      </div>

      <div class="form-row">
        <%= f.label :genre, "Genre", class: "form-label" %>
        <%= f.select :genre, options_for_select(["アクション","RPG","シミュレーション","シューティング","音楽ゲーム","レースゲーム","ホラーゲーム","ストラテジゲーム","パズル","格闘ゲーム"], review.genre), { include_blank: "選択してください" }, class: "form-control" %>
      </div>

      <div class="form-row">
        <%= f.label :platform, "Platform", class: "form-label" %>
        <%= f.select :platform, options_for_select(["PC","スマホ","switch","PS4/PS5","Xbox"], review.platform), { include_blank: "選択してください" }, class: "form-control" %>
      </div>

      <div class="form-row">
        <%= f.label :jacket, "ジャケット画像", class: "form-label" %>
        <%= f.file_field :jacket, accept: "image/png,image/jpeg,image/webp", class: "form-control-file" %>
        <% if review.jacket.attached? %>
          <div class="preview">
            <%= image_tag review.jacket.variant(resize_to_limit: [200,200]) %>
          </div>
        <% end %>
      </div>

      <div class="form-row">
        <%= f.label :body, "感想／説明", class: "form-label" %>
        <%= f.text_area :body, rows: 6, class: "form-control" %>
      </div>

      <div class="form-actions">
        <%= f.submit review.persisted? ? "更新" : "投稿", class: "btn primary large" %>
        <%= link_to "Cancel", reviews_path, class: "btn link" %>
      </div>
    </div>
  <% end %>
<% end %>