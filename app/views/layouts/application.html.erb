<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Noto+Sans+JP:wght@400;700&display=swap" rel="stylesheet">

    <title><%= content_for(:title) || "Go" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    
    <style>
  body 
  .site-header { border-bottom: 4px solid #ef4444 !important; }
  .site-header {
    background: #ffffff;
    border-bottom: 1px solid #e6e6e6;
    padding: 12px 0;
    width: 100%;
  }
  
  .header-outer {
    width: 100%;
  }
  
  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  
    padding: 0 24px;
  }
  
  /* ロゴ/サイトタイトル */
  .site-title {
    margin: 0;
    font-size: 28px;
    font-weight: 700;
    color: #111827;
    text-decoration: none;
  }
  
  /* 認証リンク */
  .auth-nav {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  
  /* 簡易ボタン */
  .btn.small {
    padding: 6px 10px;
    background: #2563eb;
    color: #fff;
    text-decoration: none;
    border-radius: 6px;
    font-size: 14px;
  }
  
  /* Logout の強調（任意）*/
  .btn.small.danger {
    background: #ef4444;
  }
  
  /* 単純リンク風 */
  .auth-link {
    padding: 6px 10px;
    color: #1f2937;
    text-decoration: none;
    border-radius: 6px;
    border: 1px solid transparent;
  }
  
  /* Sign up を目立たせる */
  .auth-link.signup {
    background: #fff;
    border: 1px solid #2563eb;
    color: #2563eb;
  }
  
  /* モバイルで縦並び */
  @media (max-width: 640px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
  
    .auth-nav {
      width: 100%;
      justify-content: flex-end;
    }
  }
  
  /* ページ本体余白 */
  .site-main {
    max-width: 1200px;
    margin: 24px auto;
    padding: 0 16px;
  }
  
  /* --- サインアップ／ログイン用カード --- */
  .auth-page {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 16px;
    min-height: calc(100vh - 120px);
    background: #f7f9fb;
  }
  
  .auth-card {
    width: 100%;
    max-width: 520px;
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 8px 30px rgba(16,24,40,0.08);
    overflow: hidden;
  }
  
  .auth-card__header {
    padding: 28px 30px 0 30px;
    text-align: left;
  }
  
  .auth-card__header h2 {
    margin: 0 0 6px 0;
    font-size: 24px;
    color: #0f172a;
  }
  
  .auth-card__header .muted {
    margin: 0;
    color: #6b7280;
    font-size: 14px;
  }
  
  .auth-card__body {
    padding: 20px 30px 30px 30px;
  }
  
  .form-group {
    margin-bottom: 16px;
  }
  
  .form-label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
    color: #111827;
  }
  
  .form-control {
    width: 100%;
    padding: 10px 12px;
    border-radius: 8px;
    border: 1px solid #e6edf3;
    background: #fff;
    box-sizing: border-box;
    font-size: 14px;
    color: #0f172a;
  }
  
  .form-control:focus {
    outline: none;
    border-color: #2563eb;
    box-shadow: 0 0 0 4px rgba(37,99,235,0.06);
  }
  
  .password-field {
    position: relative;
    display: flex;
    align-items: center;
  }
  
  .btn-toggle-password {
    position: absolute;
    right: 8px;
    top: 6px;
    background: transparent;
    border: none;
    color: #2563eb;
    font-weight: 600;
    cursor: pointer;
    padding: 6px 8px;
    border-radius: 6px;
  }
  
  .form-actions {
    margin-top: 12px;
    text-align: center;
  }
  
  .btn {
    display: inline-block;
    text-decoration: none;
    cursor: pointer;
    border-radius: 8px;
    padding: 10px 16px;
    font-weight: 600;
    border: 1px solid transparent;
  }
  
  .btn.primary {
    background: #2563eb;
    color: white;
    border-color: #2563eb;
  }
  
  .btn.large {
    padding: 12px 20px;
    font-size: 16px;
  }
  
  /* エラーメッセージ */
  .errors, .field_with_errors {
    color: #b91c1c;
    margin-bottom: 12px;
  }
  
  .auth-card__footer {
    padding: 8px 30px 28px 30px;
    text-align: center;
    border-top: 1px solid #f1f5f9;
  }
  
  .muted {
    color: #6b7280;
  }
  
  .small {
    font-size: 12px;
  }
  
  /* form card */
  .form-card {
    background: #fff;
    border-radius: 10px;
    padding: 18px;
    box-shadow: 0 6px 22px rgba(16,24,40,0.06);
    margin-bottom: 18px;
  }
  
  .form-row {
    margin-bottom: 12px;
  }
  
  .form-label {
    display: block;
    margin-bottom: 6px;
    font-weight: 700;
  }
  
  .form-control {
    width: 100%;
    padding: 10px;
    border-radius: 8px;
    border: 1px solid #e6edf3;
  }
  
  .form-control-file {
    display: block;
  }
  
  .form-actions {
    margin-top: 14px;
    display: flex;
    gap: 12px;
    align-items: center;
  }
  
  .site-title a {
  color: inherit !important;
  text-decoration: none !important;
}

.site-title a:visited {
  color: inherit !important;
}

.site-title a:hover {
  text-decoration: none !important;
  color: inherit !important;
}

.site-title a:active {
  color: inherit !important;
}
  </style>


    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "app", "reviews", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="header-outer">
      <div class="header-inner">
        <div class="brand">
          <h1 class="site-title"><%= link_to (content_for?(:title) ? content_for(:title) : "5GAME"), root_path %></h1>
        </div>

        <nav class="auth-nav">
          <%= render "shared/auth_links" %>
        </nav>
      </div>
      </div>
    </header>

    <main class="site-main">
      <%= yield %>
    </main>
  </body>
</html>