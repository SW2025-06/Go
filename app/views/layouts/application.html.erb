<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Noto+Sans+JP:wght@400;700&display=swap" rel="stylesheet">

    <title><%= content_for(:title) || "Go" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    
    <style>
  /* デバッグ用：成功すれば背景が薄黄色、ヘッダ下が赤線になります */
  body 
  .site-header { border-bottom: 4px solid #ef4444 !important; }
  </style>


    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "app", "reviews", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="header-outer">
      <div class="header-inner">
        <div class="brand">
          <h1 class="site-title"><%= link_to (content_for?(:title) ? content_for(:title) : "5GAME"), root_path %></h1>
        </div>

        <nav class="auth-nav">
          <%= render "shared/auth_links" %>
        </nav>
      </div>
      </div>
    </header>

    <main class="site-main">
      <%= yield %>
    </main>
  </body>
</html>