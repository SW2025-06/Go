<%# app/views/shared/_auth_links.html.erb %>
<% if user_signed_in? %>
  <span class="welcome">ようこそ、<%= current_user.username.presence || current_user.email %>さん</span>
  <%= link_to "New review", new_review_path, class: "btn small" %>
  <%# logout を確実に DELETE にするため turbo が効かない環境では button_to に差し替えても良いです %>
  <%= link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete }, rel: "nofollow", class: "btn small danger" %>
<% else %>
  <%= link_to "Login", new_user_session_path, class: "auth-link" %>
  <%= link_to "Sign up", new_user_registration_path, class: "auth-link signup" %>
<% end %>