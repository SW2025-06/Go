<% provide(:title, "アカウント作成") %>

<div class="auth-page">
  <div class="auth-card">
    <header class="auth-card__header">
      <h2>新規ユーザー登録</h2>
      <p class="muted">ユーザー名とパスワードで登録できます</p>
    </header>

    <div class="auth-card__body">
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>

        <div class="form-group">
          <%= f.label :username, "ユーザー名", class: "form-label" %>
          <%= f.text_field :username, autofocus: true, autocomplete: "username", class: "form-control", placeholder: "例：gamer123" %>
        </div>
        
        <div class="form-group">
          <%= f.label :password, "パスワード", class: "form-label" %>
          <div class="password-field">
            <%= f.password_field :password, autocomplete: "new-password", class: "form-control", placeholder: "8文字以上推奨" %>
            <button type="button" class="btn-toggle-password" aria-label="Toggle password">表示</button>
          </div>
          <% if @minimum_password_length %>
            <p class="muted small">大文字と小文字、数字を含む<%= @minimum_password_length %> 文字以上で登録してください</p>
          <% end %>
        </div>

        <div class="form-group">
          <%= f.label :password_confirmation, "パスワード（確認）", class: "form-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", placeholder: "もう一度入力してください" %>
        </div>

        <div class="form-actions">
          <%= f.submit "アカウントを作成する", class: "btn primary large" %>
        </div>
      <% end %>

      <div class="auth-card__footer">
        <p class="muted">すでにアカウントをお持ちですか？ <%= link_to "ログイン", new_session_path(resource_name) %></p>
      </div>
    </div>
  </div>
</div>